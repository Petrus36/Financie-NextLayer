generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  notes     String?
  ico       String?
  dic       String?
  icDph     String?
  address   String?
  city      String?
  zip       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects          Project[]
  maintenance       MaintenanceContract[]
  retainers         MonthlyRetainer[]
  invoices          Invoice[]
  invoiceTemplates  InvoiceTemplate[]
  internalDocuments InternalDocument[]
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String?
  price       Float
  status      ProjectStatus @default(ACTIVE)
  stage       ProjectStage  @default(IN_PROGRESS)
  deadline    DateTime?
  deliveredAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  expenses    ProjectExpense[]
  payments    ProjectPayment[]
  members     ProjectMember[]
  payouts     ProjectPayout[]
  tasks       ProjectTask[]
  maintenance MaintenanceContract?
  retainers   MonthlyRetainer[]
  invoices    Invoice[]
}

enum ProjectStatus {
  ACTIVE
  DELIVERED
}

enum ProjectStage {
  INQUIRY
  PLANNING
  IN_PROGRESS
  REVIEW
  DELIVERED
  PAUSED
  CANCELLED
}

model ProjectMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  notes     String?
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  payouts ProjectPayout[]
}

model ProjectPayout {
  id          String   @id @default(cuid())
  amount      Float
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  memberId  String
  member    ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectTask {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectPayment {
  id          String   @id @default(cuid())
  description String
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectExpense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  category    String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model MaintenanceContract {
  id            String   @id @default(cuid())
  monthlyAmount Float
  startDate     DateTime @default(now())
  active        Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())

  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model MonthlyRetainer {
  id               String   @id @default(cuid())
  title            String
  monthlyAmount    Float
  deliverableLabel String   @default("videí")
  targetCount      Int
  completedCount   Int      @default(0)
  active           Boolean  @default(true)
  startDate        DateTime @default(now())
  periodStart      DateTime @default(now())
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  deliveries RetainerDelivery[]
}

model RetainerDelivery {
  id          String   @id @default(cuid())
  amount      Float
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  retainerId String
  retainer   MonthlyRetainer @relation(fields: [retainerId], references: [id], onDelete: Cascade)
}

model FirmExpense {
  id          String      @id @default(cuid())
  description String
  amount      Float
  type        ExpenseType @default(ONE_TIME)
  category    String?
  date        DateTime    @default(now())
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
}

enum ExpenseType {
  ONE_TIME
  MONTHLY
}

model FirmIncome {
  id          String   @id @default(cuid())
  description String
  amount      Float
  date        DateTime @default(now())
  category    String?
  createdAt   DateTime @default(now())

  invoiceId String?  @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  internalDocument InternalDocument?
}

model InternalDocument {
  id            String   @id @default(cuid())
  description   String
  amount        Float
  date          DateTime @default(now())
  countAsIncome Boolean  @default(false)
  createdAt     DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  incomeId String?     @unique
  income   FirmIncome? @relation(fields: [incomeId], references: [id], onDelete: SetNull)
}

model CompanySettings {
  id              String  @id @default("main")
  name            String  @default("NextLayer Studio s.r.o.")
  ico             String?
  dic             String?
  icDph           String?
  address         String?
  city            String?
  zip             String?
  country         String  @default("Slovensko")
  email           String?
  phone           String?
  iban            String?
  bic             String?
  bankName        String?
  vatPayer        Boolean @default(false)
  defaultDueDays  Int     @default(14)
  notes           String?
  updatedAt       DateTime @updatedAt
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

model Invoice {
  id        String        @id @default(cuid())
  number    String        @unique
  status    InvoiceStatus @default(DRAFT)
  issuedAt  DateTime      @default(now())
  dueAt     DateTime
  paidAt    DateTime?
  notes     String?
  total     Float
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  templateId String?

  items  InvoiceItem[]
  income FirmIncome?
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Float   @default(1)
  unit        String  @default("ks")
  unitPrice   Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceTemplate {
  id          String   @id @default(cuid())
  title       String
  description String?
  quantity    Float    @default(1)
  unit        String   @default("mes.")
  unitPrice   Float
  dueDays     Int      @default(14)
  active      Boolean  @default(true)
  autoIssue   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model FirmBalance {
  id         String   @id @default("main")
  cardAmount Float    @default(0)
  cashAmount Float    @default(0)
  notes      String?
  updatedAt  DateTime @updatedAt
}

enum BillSource {
  SCAN
  EMAIL
  MANUAL
}

enum BillStatus {
  INBOX
  READY
  SENT
  DONE
}

model Bill {
  id            String     @id @default(cuid())
  vendor        String
  title         String?
  amount        Float?
  billDate      DateTime   @default(now())
  invoiceNumber String?
  category      String?
  source        BillSource @default(MANUAL)
  status        BillStatus @default(INBOX)
  notes         String?
  emailLink     String?
  fileName      String?
  fileMime      String?
  fileData      Bytes?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}
